{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"!**/node_modules/",
			"!**/.vscode/**/*.txt",
			"!**/.dist",
			"!**/.astro",
			"!**/esm",
			"!**/*.code-workspace",
			"!**/tailwind.css",
			"!packages/storybook-addon-vis/.storybook/local-preset.cjs",
			"!packages/storybook-addon-vis/manager.js",
			"!packages/storybook-addon-vis/preset.js"
		]
	},
	"overrides": [
		{
			// Biome only parses an Astro file's frontmatter, so it cannot see imports and variables used in the template.
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" }
				}
			}
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"rules": {
			"a11y": {
				"noSvgWithoutTitle": "off",
				"useAltText": "off",
				"useSemanticElements": "off"
			},
			"correctness": {
				"useImportExtensions": "error"
			},
			"suspicious": {
				"noArrayIndexKey": "off"
			}
		}
	},
	"javascript": {
		"jsxRuntime": "reactClassic"
	}
}
