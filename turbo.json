{
	"$schema": "./node_modules/turbo/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", "esm/**", "*.tsbuildinfo"]
		},
		"//#check": {},
		"//#docs:llms:check": {
			"cache": false
		},
		"clean": {
			"cache": false
		},
		"clean:vis:local": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"coverage": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["coverage/**", "__vis__/**"]
		},
		"coverage:u": {
			"cache": false,
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["coverage/**", "__vis__/**"]
		},
		"nuke": {
			"cache": false,
			"dependsOn": ["clean"]
		},
		"storybook-addon-vis#build:sb": {
			"dependsOn": ["build"],
			"outputs": ["storybook-static/**"]
		},
		"storybook-addon-vis#coverage": {
			"dependsOn": ["build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["coverage/**", "__vis__/**"]
		},
		"storybook-addon-vis#coverage:u": {
			"cache": false,
			"dependsOn": ["build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["coverage/**", "__vis__/**"]
		},
		"storybook-addon-vis#test": {
			"dependsOn": ["build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["__vis__/**"]
		},
		"storybook-addon-vis#test:u": {
			"cache": false,
			"dependsOn": ["build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["__vis__/**"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["__vis__/**"]
		},
		"t:t": {
			"dependsOn": ["^build"]
		},
		"test:u": {
			"cache": false,
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["__vis__/**"]
		},
		"testcase-sb-auto-no-snapshot-tag#test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"testcase-sb-control#test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"testcase-sb-csf-mix#test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"testcase": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["__vis__/**"]
		},
		"testcase:u": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["__vis__/**"]
		},
		"w": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".storybook", "*.ts"],
			"outputs": ["__vis__/**"],
			"persistent": true
		}
	}
}
