{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": [
				"^build",
				"storybook-addon-vis#build:sb",
				"testcase-themes#build:sb",
				"testcase-multi-instances#build:sb",
				"testcase-sb-csf-next#build:sb"
			],
			"env": ["SITE_BASE"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^build", "build"]
		}
	}
}
