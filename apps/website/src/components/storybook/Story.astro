---
import StoryLink from './StoryLink.astro'
import { buildIframeUrl, type StoryValue, titleFromId } from './story-url.ts'

interface Props {
	/** Story id, e.g. `button--primary`. Required. */
	id: string
	/** Accessible iframe title. Default derived from `id`. */
	title?: string
	/** Height in px (number) or any CSS length (string). Default 300. */
	height?: number | string
	/** Initial args, serialised to Storybook's `args=` format. */
	args?: Record<string, StoryValue>
	/** Initial globals, serialised to Storybook's `globals=` format. */
	globals?: Record<string, StoryValue>
	/** Native iframe loading. Default `lazy`. */
	loading?: 'lazy' | 'eager'
	/** Show the "Open in Storybook" link under the iframe. Default true. */
	link?: boolean
	/** Directory of the Storybook build relative to the site base. Default `storybook`. */
	storybookPath?: string
}

const {
	id,
	title = titleFromId(id),
	height = 300,
	args,
	globals,
	loading = 'lazy',
	link = true,
	storybookPath,
} = Astro.props
const src = buildIframeUrl({ base: import.meta.env.BASE_URL, id, args, globals, storybookPath })
const cssHeight = typeof height === 'number' ? `${height}px` : height
---

<figure class="story-embed">
	<iframe src={src} title={title} loading={loading} style={`height:${cssHeight}`}></iframe>
	{link && <figcaption><StoryLink id={id} storybookPath={storybookPath} /></figcaption>}
</figure>

<style>
	.story-embed {
		margin: 1.5rem 0;
	}
	iframe {
		display: block;
		width: 100%;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		/* Storybook renders on its own background (white by default), so the frame stays a
		   self-contained "canvas" in both Starlight themes rather than inheriting the page colour. */
		background: #fff;
		color-scheme: normal;
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
	}
</style>
